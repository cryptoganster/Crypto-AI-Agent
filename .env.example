# Environment
ENVIRONMENT=development

# Logging Configuration
LOG_LEVEL=INFO
LOG_ROTATION=1 day
LOG_RETENTION=2 days
ENABLE_FILE_LOGGING=true
ENABLE_CONSOLE_LOGGING=true
ENABLE_WARNING_LOGGING=true
ENABLE_JSON_LOGGING=false
LOG_SERIALIZE=false
LOG_BACKTRACE=true
LOG_DIAGNOSE=true

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tradingapp
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Redis Configuration (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=false

# RSS Fetching Configuration
FETCH_TIMEOUT=30
FETCH_MAX_RETRIES=3
FETCH_RETRY_DELAY=5
FETCH_USER_AGENT=Mozilla/5.0 (compatible; ScrapingService/1.0)

# Scheduling Configuration
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Monitoring
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true

# External Services
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=100

# Chunking Configuration
CHUNKING_CHUNK_SIZE=1200
CHUNKING_CHUNK_OVERLAP=150
CHUNKING_MIN_CHUNK_SIZE=100
CHUNKING_MAX_CHUNK_SIZE=1500

# Embedding Configuration (Ollama Local - No API Key Required)
# Modelos recomendados en Ollama:
# - nomic-embed-text (768 dim) - Recomendado para embeddings
# - mxbai-embed-large (1024 dim) - Embeddings grandes
# Instalar modelo: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# Clustering Configuration
CLUSTERING_ALGORITHM=kmeans
CLUSTERING_N_CLUSTERS=10
CLUSTERING_DBSCAN_EPS=0.3
CLUSTERING_DBSCAN_MIN_SAMPLES=2
CLUSTERING_MIN_CLUSTER_SIZE=3
CLUSTERING_RANDOM_STATE=42

# AI Processing Pipeline Configuration
# Feature Flags
AI_USE_NEW_PIPELINE=false
AI_ENABLE_GLOBAL_SUMMARY=true
AI_ENABLE_TLDR=true

# Text Limits
AI_MAX_TEXT_LENGTH_GLOBAL_SUMMARY=10000
AI_MAX_CHUNK_SUMMARIES_TLDR=10

# Retry Configuration
AI_MAX_RETRIES=3
AI_RETRY_DELAY_SECONDS=2.0

# Timeouts (in seconds)
AI_CHUNKING_TIMEOUT=30.0
AI_EMBEDDING_TIMEOUT=60.0
AI_SUMMARIZATION_TIMEOUT=120.0

# Batch Processing
AI_SUMMARY_BATCH_SIZE=5
